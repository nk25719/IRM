# Application environment: development, staging, or production.
APP_ENV=development

# PostgreSQL SQLAlchemy database URL.
DATABASE_URL=postgresql+psycopg2://irm_user:change_me@localhost:5432/irm

# Docker/PostgreSQL defaults for local office deployment.
POSTGRES_DB=irm
POSTGRES_USER=irm_user
POSTGRES_PASSWORD=change_me

# Required in production. Use a long random value.
SESSION_SECRET=change-this-to-a-long-random-production-secret
SESSION_COOKIE_SECURE=false
APP_USERNAME=admin
APP_PASSWORD=change_me

# Application file storage root. Do not point this at the Git repository in production.
IRM_DATA_ROOT=/data/irm

# Optional: point this to your synced Excel file path.
EXCEL_PATH="./app/data/inventory_master.xlsx"
